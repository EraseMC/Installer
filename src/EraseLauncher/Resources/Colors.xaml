<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ERASE palette: off-black with a faint green cast and a single lime accent. -->
    <Color x:Key="Color.Background">#070A07</Color>
    <Color x:Key="Color.BackgroundDeep">#040604</Color>
    <Color x:Key="Color.Text">#ECF1EA</Color>
    <Color x:Key="Color.Text2">#AAB6A9</Color>
    <Color x:Key="Color.Text3">#8A968A</Color>
    <Color x:Key="Color.Accent">#A8F038</Color>
    <Color x:Key="Color.AccentHover">#B8F95A</Color>
    <Color x:Key="Color.AccentInk">#0A1206</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>
    <Color x:Key="Color.Warning">#F5B942</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}" />
    <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource Color.Text3}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource Color.AccentInk}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1FA8F038" />
    <SolidColorBrush x:Key="Brush.AccentLine" Color="#47A8F038" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1AFF6B6B" />
    <SolidColorBrush x:Key="Brush.DangerLine" Color="#4DFF6B6B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Line" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Brush.Track" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12FFFFFF" />

    <!-- Liquid glass: a faint vertical fill, and a rim that catches light at the top
         left and fades towards the bottom right. -->
    <LinearGradientBrush x:Key="Brush.GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassFillStrong" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2161C15" Offset="0" />
        <GradientStop Color="#F20E120D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.45" />
        <GradientStop Color="#08FFFFFF" Offset="0.7" />
        <GradientStop Color="#1CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8FD82A" Offset="0" />
        <GradientStop Color="#C4FF6A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
