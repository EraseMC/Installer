<Window x:Class="EraseLauncher.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:EraseLauncher.ViewModels"
 Title="Erase Launcher" Width="1100" Height="700" MinWidth="900" MinHeight="620" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Background="#10140F" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="TitleControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="52"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/></Style>
  <Style x:Key="CloseTitleControl" TargetType="Button" BasedOn="{StaticResource TitleControl}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33F15B5B"/><Setter Property="Foreground" Value="#FFF2F0"/></Trigger></Style.Triggers></Style>
  <Style x:Key="TopNav" TargetType="RadioButton"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="15,0"/><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/><Setter Property="FontFamily" Value="{StaticResource Font.Body}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Root" Background="Transparent" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1C2619"/><Setter Property="Foreground" Value="{StaticResource Brush.Text}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#24331E"/><Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsNav" TargetType="RadioButton"><Setter Property="Height" Value="54"/><Setter Property="Padding" Value="13,0"/><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/><Setter Property="FontFamily" Value="{StaticResource Font.Body}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Root" Background="Transparent" CornerRadius="14"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1D271A"/><Setter Property="Foreground" Value="{StaticResource Brush.Text}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#B9FA57"/><Setter Property="Foreground" Value="{StaticResource Brush.AccentDark}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="VersionCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Width" Value="326"/><Setter Property="Height" Value="250"/><Setter Property="Margin" Value="0,0,18,18"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <Border Background="#10140F" BorderBrush="#283125" BorderThickness="1" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Background="#121711" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0"><Grid Width="34" Height="34" Margin="0,0,12,0"><Polygon Points="17,0 32,8 32,26 17,34 2,26 2,8" Fill="{StaticResource Brush.Accent}"/><Path Data="M12,10 H24 V14 H17 V16 H22 V20 H17 V24 H24 V28 H12 Z" Fill="{StaticResource Brush.AccentDark}"/></Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="ERASE" Foreground="{StaticResource Brush.Text}" FontWeight="Bold" FontSize="17"/><TextBlock Text="LAUNCHER" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="9"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" GroupName="TopNavigation" Content="HOME"/><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsVersions, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" GroupName="TopNavigation" Content="VERSIONS" Margin="8,0"/><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Settings}" GroupName="TopNavigation" Content="SETTINGS"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0"><Button Style="{StaticResource TitleControl}" Click="Minimize_OnClick" ToolTip="Minimize"><Path Data="M14,22 H30" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round"/></Button><Button Style="{StaticResource TitleControl}" Click="Maximize_OnClick" ToolTip="Maximize or restore"><Path Data="M15,14 H28 V27 H15 Z M18,11 H31 V24" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Fill="Transparent"/></Button><Button Style="{StaticResource CloseTitleControl}" Click="Close_OnClick" ToolTip="Close"><Path Data="M16,16 L28,28 M28,16 L16,28" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round"/></Button></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}" ClipToBounds="True"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11170F" Offset="0"/><GradientStop Color="#0D110C" Offset=".5"/><GradientStop Color="#080A08" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="680" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-230,-160,0" Opacity=".2"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#98D747" Offset="0"/><GradientStop Color="#314C20" Offset=".45"/><GradientStop Color="#0D100C" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="64"/></Ellipse.Effect></Ellipse>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Margin="0,-12,0,0"><TextBlock Text="ERASE LEGACY" HorizontalAlignment="Center" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}"/><TextBlock Text="Ready to play?" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" FontSize="42" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding InstalledVersion}" HorizontalAlignment="Center" Style="{StaticResource Type.Body}" TextAlignment="Center"/><Button Style="{StaticResource Button.Primary}" Height="58" Margin="40,28,40,10" Command="{Binding PlayCommand}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="M0,0 L0,16 L13,8 Z" Fill="{StaticResource Brush.AccentDark}" Width="13" Height="16" Stretch="Fill" Margin="0,0,11,0"/><TextBlock Text="LAUNCH MINECRAFT" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource Button.Secondary}" Height="52" Margin="40,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" Content="MANAGE VERSIONS"/></StackPanel>
    <Grid VerticalAlignment="Bottom" Margin="28,0,28,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#B9131812" BorderBrush="#33402E" BorderThickness="1" CornerRadius="14" Padding="15,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="NETWORK" Style="{StaticResource Type.Eyebrow}"/><TextBlock Text="Erase Community" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#B9131812" BorderBrush="#33402E" BorderThickness="1" CornerRadius="14" Padding="15,12" Margin="8,0"><StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource Type.Eyebrow}"/><TextBlock Text="{Binding ManifestStatus}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Height="60" Margin="8,0,0,0" Command="{Binding OpenDiscordCommand}" Content="JOIN DISCORD"/></Grid>
   </Grid>
   <Grid Visibility="{Binding IsVersions, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="42,32,42,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Your versions" Style="{StaticResource Type.PageTitle}"/><TextBlock Text="Choose a verified legacy build for Erase." Style="{StaticResource Type.Body}" Margin="0,6,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="132" Height="50" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Content="REFRESH"/></Grid><Border Grid.Row="2" Background="#172016" BorderBrush="#34402F" BorderThickness="1" CornerRadius="14" Padding="15,11"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock Text="{Binding ManifestStatus}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border><ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Versions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource VersionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding Id}" Foreground="{StaticResource Brush.Text}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="MINECRAFT BEDROCK" Style="{StaticResource Type.Eyebrow}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Type.Body}"/><Border HorizontalAlignment="Left" Background="#26331E" CornerRadius="9" Padding="9,5" Margin="0,14,0,0"><TextBlock Text="VERIFIED DOWNLOAD" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}"/></Border></StackPanel><Button Grid.Row="2" Style="{StaticResource Button.Primary}" Height="54" Command="{Binding DataContext.OpenInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="INSTALL"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
   <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="22,20"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#151A14" BorderBrush="#30392C" BorderThickness="1" CornerRadius="20" Padding="14"><DockPanel><Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Secondary}" Height="52" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" Content="RETURN HOME"/><StackPanel><StackPanel Orientation="Horizontal" Margin="7,5,0,24"><Grid Width="30" Height="30" Margin="0,0,11,0"><Polygon Points="15,0 29,8 29,23 15,31 1,23 1,8" Fill="{StaticResource Brush.Accent}"/><Path Data="M10,10 H22 V14 H15 V16 H20 V20 H15 V24 H22 V28 H10 Z" Fill="{StaticResource Brush.AccentDark}"/></Grid><TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}"/></StackPanel><RadioButton Style="{StaticResource SettingsNav}" IsChecked="{Binding IsGeneralSettings, Mode=OneWay}" Command="{Binding NavigateSettingsCommand}" CommandParameter="{x:Static vm:SettingsSection.General}" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 0 12.1,3 M12,7 V8 M12,11 V17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="General" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource SettingsNav}" IsChecked="{Binding IsDownloadsSettings, Mode=OneWay}" Command="{Binding NavigateSettingsCommand}" CommandParameter="{x:Static vm:SettingsSection.Downloads}" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><Path Data="M12,3 V14 M7,10 L12,15 L17,10 M4,20 H20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Downloads" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource SettingsNav}" IsChecked="{Binding IsAboutSettings, Mode=OneWay}" Command="{Binding NavigateSettingsCommand}" CommandParameter="{x:Static vm:SettingsSection.About}" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 0 12.1,3 M12,11 V17 M12,7 V8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></RadioButton></StackPanel></DockPanel></Border>
    <Border Grid.Column="2" Background="#171C16" BorderBrush="#30392C" BorderThickness="1" CornerRadius="20" Padding="30,24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><StackPanel Visibility="{Binding IsGeneralSettings, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="General" Style="{StaticResource Type.PageTitle}" FontSize="30"/><TextBlock Text="Choose how Erase Launcher behaves on this computer." Style="{StaticResource Type.Body}" Margin="0,6,0,20"/><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="LAUNCHER" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,8"/><CheckBox Style="{StaticResource Toggle}" Content="Launch Minecraft after installation" IsChecked="{Binding Settings.LaunchAfterInstall}"/><CheckBox Style="{StaticResource Toggle}" Content="Check for launcher updates" IsChecked="{Binding Settings.CheckForUpdates}"/></StackPanel></Border><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="DATA &amp; COMMUNITY" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,8"/><CheckBox Style="{StaticResource Toggle}" Content="Remember selected version" IsChecked="{Binding Settings.RememberSelectedVersion}"/><CheckBox Style="{StaticResource Toggle}" Content="Open Discord after first install" IsChecked="{Binding Settings.OpenDiscordAfterFirstInstall}"/></StackPanel></Border><Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Width="178" Height="54" Command="{Binding SaveSettingsCommand}" Content="SAVE CHANGES"/></StackPanel><StackPanel Visibility="{Binding IsDownloadsSettings, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Downloads" Style="{StaticResource Type.PageTitle}" FontSize="30"/><TextBlock Text="Manage verified installation files stored by Erase Launcher." Style="{StaticResource Type.Body}" Margin="0,6,0,20"/><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="LOCAL CACHE" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}"/><TextBlock Text="Clearing the cache never removes Minecraft worlds or installed packages." Style="{StaticResource Type.Body}" Margin="0,9,0,18"/><WrapPanel><Button Style="{StaticResource Button.Secondary}" Width="156" Height="52" Command="{Binding OpenLauncherFolderCommand}" Content="OPEN FOLDER" Margin="0,0,10,10"/><Button Style="{StaticResource Button.Secondary}" Width="140" Height="52" Command="{Binding OpenLogsFolderCommand}" Content="OPEN LOGS" Margin="0,0,10,10"/><Button Style="{StaticResource Button.Secondary}" Width="148" Height="52" Command="{Binding ClearCacheCommand}" Content="CLEAR CACHE" Margin="0,0,10,10"/></WrapPanel></StackPanel></Border></StackPanel><StackPanel Visibility="{Binding IsAboutSettings, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="About Erase" Style="{StaticResource Type.PageTitle}" FontSize="30"/><TextBlock Text="A focused launcher for verified legacy Minecraft Bedrock builds used by Erase." Style="{StaticResource Type.Body}" Margin="0,6,0,20"/><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="ERASE LAUNCHER" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}"/><TextBlock Text="Build 0.1.0" Foreground="{StaticResource Brush.Text}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Downloads are served from Erase CDN and verified with SHA-256 before installation." Style="{StaticResource Type.Body}"/><Button Style="{StaticResource Button.Secondary}" Width="164" Height="52" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding OpenDiscordCommand}" Content="JOIN DISCORD"/></StackPanel></Border></StackPanel></Grid></ScrollViewer></Border></Grid>
   <Grid Visibility="{Binding IsInstallation, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#0E120D"><Border Width="560" Background="#161C14" BorderBrush="#33402E" BorderThickness="1" CornerRadius="22" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="INSTALLATION" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}"/><TextBlock Text="{Binding InstallationMessage}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" Margin="0,10,0,0"/><ProgressBar Height="8" Margin="0,28,0,10" Minimum="0" Maximum="100" Value="{Binding InstallationPercentage, Mode=OneWay}"/><Grid><TextBlock Text="{Binding InstallationPercentage, StringFormat={}{0:0}%}" Style="{StaticResource Type.Body}"/><Button HorizontalAlignment="Right" Width="124" Height="50" Style="{StaticResource Button.Secondary}" Command="{Binding CancelInstallationCommand}" Content="CANCEL"/></Grid><TextBlock Text="Every file is verified before Windows package changes begin." Style="{StaticResource Type.Body}" Margin="0,27,0,0"/></StackPanel></Border></Grid>
  </Grid>
  <Border Grid.RowSpan="2" Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#B8000000"><Grid><Border Width="480" Background="#192016" BorderBrush="#425139" BorderThickness="1" CornerRadius="22" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Install this version?" Style="{StaticResource Type.PageTitle}" FontSize="29"/><TextBlock Text="{Binding SelectedVersion.DisplayName}" Foreground="{StaticResource Brush.Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Erase verifies all package files before it changes your installed Minecraft version." Style="{StaticResource Type.Body}" Margin="0,12,0,23"/><CheckBox Style="{StaticResource Toggle}" Content="Preserve worlds and packs" IsChecked="{Binding PreserveData}" Margin="0,0,0,26"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Button.Secondary}" Width="122" Height="52" Command="{Binding CancelConfirmationCommand}" Content="CANCEL" Margin="0,0,10,0"/><Button Style="{StaticResource Button.Primary}" Width="132" Height="52" Command="{Binding ConfirmInstallCommand}" Content="INSTALL"/></StackPanel></StackPanel></Border></Grid></Border>
 </Grid></Border>
</Window>
