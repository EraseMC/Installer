<Window x:Class="EraseLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EraseLauncher.Models"
        xmlns:vm="clr-namespace:EraseLauncher.ViewModels"
        Title="Erase Launcher"
        Width="1100" Height="700" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Brush.Background}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceElevated}" /><Setter Property="Foreground" Value="{StaticResource Brush.Text}" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Brush.Sidebar}" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource Brush.Accent}" Margin="0,0,9,0"><TextBlock Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" /></Border>
                <TextBlock Text="ERASE" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleButton}" Content="—" Click="Minimize_OnClick" ToolTip="Minimize" />
                <Button Style="{StaticResource TitleButton}" Content="□" Click="Maximize_OnClick" ToolTip="Maximize or restore" />
                <Button Style="{StaticResource TitleButton}" Content="×" Click="Close_OnClick" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,14,14,18">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,12" />
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenDiscordCommand}" Content="JOIN DISCORD" />
                        <TextBlock Text="{Binding LauncherVersion, StringFormat=Erase Launcher v{0}}" Style="{StaticResource Type.Body}" Margin="9,14,0,0" FontSize="12" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="NAVIGATION" Style="{StaticResource Type.Body}" FontSize="11" Margin="10,10,0,9" />
                        <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" GroupName="Navigation"><TextBlock Text="Home" /></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsVersions, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" GroupName="Navigation"><TextBlock Text="Versions" /></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Settings}" GroupName="Navigation"><TextBlock Text="Settings" /></RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="44,36">
                <Grid Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Erase Launcher" Style="{StaticResource Type.PageTitle}" />
                        <TextBlock Text="Legacy Minecraft made simple." Style="{StaticResource Type.Body}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="144" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Background="{StaticResource Brush.SurfaceElevated}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MINECRAFT BEDROCK" Style="{StaticResource Type.Body}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InstalledVersion}" Style="{StaticResource Type.SectionTitle}" Margin="0,10,0,8" />
                                    <TextBlock Text="Install a supported legacy build or launch the Minecraft package detected by Windows." Style="{StaticResource Type.Body}" MaxWidth="450" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Primary}" Command="{Binding PlayCommand}" Content="PLAY" Margin="0,0,0,10" />
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" Content="CHANGE VERSION" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,11,0"><StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource Type.Body}" FontSize="11" /><TextBlock Text="{Binding ManifestStatus}" Style="{StaticResource Type.SectionTitle}" Margin="0,8,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="11,0,0,0"><Grid><StackPanel><TextBlock Text="ERASE COMMUNITY" Style="{StaticResource Type.Body}" FontSize="11" /><TextBlock Text="Play with the community." Style="{StaticResource Type.SectionTitle}" Margin="0,8,0,0" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Button.Secondary}" Command="{Binding OpenDiscordCommand}" Content="OPEN" /></Grid></Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsVersions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Minecraft Versions" Style="{StaticResource Type.PageTitle}" /><TextBlock Text="Install and switch between supported legacy versions." Style="{StaticResource Type.Body}" Margin="0,8,0,0" /></StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><DockPanel><TextBlock Text="{Binding ManifestStatus}" Style="{StaticResource Type.Body}" VerticalAlignment="Center" /><Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Width="102" Command="{Binding RefreshCommand}" Content="REFRESH" /></DockPanel></Border>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Versions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300" Height="222" Margin="0,0,18,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="MINECRAFT BEDROCK" Style="{StaticResource Type.Body}" FontSize="11" /><TextBlock Text="{Binding Id}" Style="{StaticResource Type.SectionTitle}" FontSize="25" Margin="0,10,0,0" /></StackPanel><TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Type.Body}" VerticalAlignment="Center" /><Button Grid.Row="2" Style="{StaticResource Button.Primary}" Command="{Binding DataContext.OpenInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="INSTALL" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Settings" Style="{StaticResource Type.PageTitle}" /><TextBlock Text="Control how Erase Launcher downloads and installs Minecraft." Style="{StaticResource Type.Body}" Margin="0,8,0,0" /></StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="GENERAL" Style="{StaticResource Type.Body}" FontSize="11" Margin="0,0,0,16" /><CheckBox Content="Launch Minecraft after installation" IsChecked="{Binding Settings.LaunchAfterInstall}" Margin="0,0,0,14" /><CheckBox Content="Open Erase Discord after first successful installation" IsChecked="{Binding Settings.OpenDiscordAfterFirstInstall}" Margin="0,0,0,14" /><CheckBox Content="Check for launcher updates" IsChecked="{Binding Settings.CheckForUpdates}" Margin="0,0,0,14" /><CheckBox Content="Remember selected version" IsChecked="{Binding Settings.RememberSelectedVersion}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="DOWNLOADS" Style="{StaticResource Type.Body}" FontSize="11" Margin="0,0,0,16" /><TextBlock Text="The automatic mirror setting uses the first verified HTTPS source from the manifest and tries the next one if necessary." Style="{StaticResource Type.Body}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ADVANCED" Style="{StaticResource Type.Body}" FontSize="11" Margin="0,0,0,16" /><WrapPanel><Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenLauncherFolderCommand}" Content="OPEN LAUNCHER FOLDER" Margin="0,0,10,10" /><Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenLogsFolderCommand}" Content="OPEN LOGS" Margin="0,0,10,10" /><Button Style="{StaticResource Button.Secondary}" Command="{Binding ClearCacheCommand}" Content="CLEAR DOWNLOAD CACHE" Margin="0,0,10,10" /></WrapPanel><Button HorizontalAlignment="Left" Style="{StaticResource Button.Primary}" Command="{Binding SaveSettingsCommand}" Content="SAVE SETTINGS" /></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsInstallation, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"><Border Style="{StaticResource Card}" Padding="36"><StackPanel><TextBlock Text="Installation" Style="{StaticResource Type.PageTitle}" /><TextBlock Text="{Binding InstallationMessage}" Style="{StaticResource Type.SectionTitle}" Margin="0,14,0,0" /><ProgressBar Height="8" Margin="0,28,0,8" Minimum="0" Maximum="100" Value="{Binding InstallationPercentage, Mode=OneWay}" /><DockPanel><TextBlock Text="{Binding InstallationPercentage, StringFormat={}{0:0}%}" Style="{StaticResource Type.Body}" /><Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Width="110" Command="{Binding CancelInstallationCommand}" Content="CANCEL" /></DockPanel><TextBlock Text="Downloads are verified with SHA-256 before Windows package changes begin." Style="{StaticResource Type.Body}" Margin="0,30,0,0" /></StackPanel></Border></Grid>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#A6000000">
            <Grid><Border Width="470" Style="{StaticResource Card}" Background="{StaticResource Brush.SurfaceElevated}" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Install Minecraft?" Style="{StaticResource Type.PageTitle}" FontSize="26" /><TextBlock Text="{Binding SelectedVersion.DisplayName}" Style="{StaticResource Type.SectionTitle}" Margin="0,14,0,0" /><TextBlock Text="Erase Launcher will download and verify every required file before it changes your existing Minecraft installation." Style="{StaticResource Type.Body}" Margin="0,14,0,24" /><CheckBox Content="Preserve Minecraft worlds and packs" IsChecked="{Binding PreserveData}" Margin="0,0,0,26" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelConfirmationCommand}" Content="CANCEL" Margin="0,0,10,0" /><Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmInstallCommand}" Content="INSTALL" /></StackPanel></StackPanel></Border></Grid>
        </Border>
    </Grid>
</Window>
