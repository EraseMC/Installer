<Window x:Class="EraseLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EraseLauncher.ViewModels"
        Title="Erase Launcher" Width="1100" Height="700" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" Background="#080A08" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="15" /></Style>
        <Style x:Key="TopNav" TargetType="RadioButton"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" /><Setter Property="FontFamily" Value="{StaticResource Font.Body}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Root" Background="Transparent" CornerRadius="18"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1E2A1B" /><Setter Property="Foreground" Value="{StaticResource Brush.Text}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#24301D" /><Setter Property="Foreground" Value="{StaticResource Brush.Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SideNav" TargetType="RadioButton"><Setter Property="Height" Value="50" /><Setter Property="Padding" Value="14,0" /><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" /><Setter Property="FontFamily" Value="{StaticResource Font.Body}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Root" Background="Transparent" CornerRadius="14"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1E251C" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent}" /><Setter Property="Foreground" Value="{StaticResource Brush.AccentDark}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="VersionCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Width" Value="306" /><Setter Property="Height" Value="220" /><Setter Property="Margin" Value="0,0,18,18" /><Setter Property="Padding" Value="22" /></Style>
    </Window.Resources>
    <Border Margin="12" Background="#10140F" BorderBrush="#2B3428" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#121711" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0"><Grid Width="34" Height="34" Margin="0,0,12,0"><Polygon Points="17,0 32,8 32,26 17,34 2,26 2,8" Fill="{StaticResource Brush.Accent}" /><TextBlock Text="E" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Brush.AccentDark}" FontSize="17" FontWeight="Bold" /></Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="ERASE" Foreground="{StaticResource Brush.Text}" FontWeight="Bold" FontSize="17" /><TextBlock Text="LAUNCHER" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="9" /></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" GroupName="TopNavigation" Content="HOME" /><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsVersions, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" GroupName="TopNavigation" Content="VERSIONS" Margin="8,0" /><RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Settings}" GroupName="TopNavigation" Content="SETTINGS" /></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"><Border Background="#1D251A" CornerRadius="15" Padding="10,5" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="GUEST" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" FontSize="10" /></StackPanel></Border><Button Style="{StaticResource TitleButton}" Content="—" Click="Minimize_OnClick" ToolTip="Minimize" /><Button Style="{StaticResource TitleButton}" Content="□" Click="Maximize_OnClick" ToolTip="Maximize or restore" /><Button Style="{StaticResource TitleButton}" Content="×" Click="Close_OnClick" ToolTip="Close" /></StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}" ClipToBounds="True">
                    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11170F" Offset="0" /><GradientStop Color="#0E110D" Offset="0.44" /><GradientStop Color="#080A08" Offset="1" /></LinearGradientBrush></Grid.Background>
                    <Ellipse Width="730" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-170,0" Opacity="0.24"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#9FCF46" Offset="0" /><GradientStop Color="#344B1F" Offset="0.42" /><GradientStop Color="#0D100C" Offset="1" /></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="64" /></Ellipse.Effect></Ellipse><Ellipse Width="600" Height="230" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-210,0,0,-125" Opacity="0.16" Fill="#8DBD37"><Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect></Ellipse>
                    <Border Width="142" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,25" Background="#C7151A14" BorderBrush="#43523B" BorderThickness="1" CornerRadius="17"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}" Margin="0,0,7,0" /><TextBlock Text="LEGACY BEDROCK" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Text}" /></StackPanel></Border><TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,30,0" Text="{Binding LauncherVersion, StringFormat=BUILD {0}}" Style="{StaticResource Type.Eyebrow}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Margin="0,-6,0,0"><TextBlock Text="WELCOME BACK" HorizontalAlignment="Center" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" /><TextBlock Text="Ready to play?" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" FontSize="42" FontWeight="SemiBold" Margin="0,12,0,2" /><TextBlock Text="{Binding InstalledVersion}" HorizontalAlignment="Center" Style="{StaticResource Type.Body}" TextAlignment="Center" /><Button Style="{StaticResource Button.Primary}" Height="56" Margin="48,26,48,10" Command="{Binding PlayCommand}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="M0,0 L0,15 L12,7.5 Z" Fill="{StaticResource Brush.AccentDark}" Width="12" Height="15" Stretch="Fill" Margin="0,0,10,0" /><TextBlock Text="LAUNCH MINECRAFT" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel></Button><Button Style="{StaticResource Button.Secondary}" Height="48" Margin="48,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Versions}" Content="MANAGE VERSIONS" /></StackPanel>
                    <Grid VerticalAlignment="Bottom" Margin="28,0,28,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#B9131812" BorderBrush="#33402E" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,8,0"><StackPanel><TextBlock Text="NETWORK" Style="{StaticResource Type.Eyebrow}" /><TextBlock Text="Erase Community" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Column="1" Background="#B9131812" BorderBrush="#33402E" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="8,0"><StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource Type.Eyebrow}" /><TextBlock Text="{Binding ManifestStatus}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Border><Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Height="58" Margin="8,0,0,0" Command="{Binding OpenDiscordCommand}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" Margin="0,0,9,0" /><TextBlock Text="JOIN DISCORD" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel></Button></Grid>
                </Grid>
                <Grid Visibility="{Binding IsVersions, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="46,34,46,30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Your versions" Style="{StaticResource Type.PageTitle}" /><TextBlock Text="Choose a verified legacy build for Erase." Style="{StaticResource Type.Body}" Margin="0,6,0,0" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="120" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Content="REFRESH" /></Grid><Border Grid.Row="2" Background="#172016" BorderBrush="#34402F" BorderThickness="1" CornerRadius="14" Padding="15,11"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Text="{Binding ManifestStatus}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Border><ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Versions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource VersionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#25301F" CornerRadius="12"><TextBlock Text="MC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MINECRAFT BEDROCK" Style="{StaticResource Type.Eyebrow}" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource Brush.Text}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Type.Body}" /><Border HorizontalAlignment="Left" Background="#26331E" CornerRadius="9" Padding="8,4" Margin="0,13,0,0"><TextBlock Text="VERIFIED DOWNLOAD" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" /></Border></StackPanel><Button Grid.Row="2" Style="{StaticResource Button.Primary}" Command="{Binding DataContext.OpenInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="INSTALL" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                <Grid Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,22"><Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#151A14" BorderBrush="#30392C" BorderThickness="1" CornerRadius="22" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Style="{StaticResource Button.Secondary}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" Content="←  RETURN HOME" /></StackPanel><StackPanel><StackPanel Orientation="Horizontal" Margin="6,5,0,22"><Grid Width="30" Height="30" Margin="0,0,11,0"><Polygon Points="15,0 29,8 29,23 15,31 1,23 1,8" Fill="{StaticResource Brush.Accent}" /><TextBlock Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Brush.AccentDark}" /></Grid><TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" /></StackPanel><RadioButton Style="{StaticResource SideNav}" IsChecked="True" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Margin="0,0,10,0" /><TextBlock Text="General" /></StackPanel></RadioButton><RadioButton Style="{StaticResource SideNav}" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" Margin="0,0,10,0" /><TextBlock Text="Downloads" /></StackPanel></RadioButton><RadioButton Style="{StaticResource SideNav}" GroupName="SettingsNavigation"><StackPanel Orientation="Horizontal"><TextBlock Text="?" Margin="0,0,10,0" /><TextBlock Text="About" /></StackPanel></RadioButton></StackPanel></DockPanel></Border><Border Grid.Column="2" Background="#171C16" BorderBrush="#30392C" BorderThickness="1" CornerRadius="22" Padding="28,18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="General" Style="{StaticResource Type.PageTitle}" FontSize="28" /><TextBlock Text="Make Erase Launcher work the way you prefer." Style="{StaticResource Type.Body}" Margin="0,5,0,16" /><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="LAUNCHER" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6" /><CheckBox Style="{StaticResource Toggle}" Content="Launch Minecraft after installation" IsChecked="{Binding Settings.LaunchAfterInstall}" /><CheckBox Style="{StaticResource Toggle}" Content="Check for launcher updates" IsChecked="{Binding Settings.CheckForUpdates}" /></StackPanel></Border><Border Background="#121611" BorderBrush="#2C3629" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="DATA &amp; COMMUNITY" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6" /><CheckBox Style="{StaticResource Toggle}" Content="Remember selected version" IsChecked="{Binding Settings.RememberSelectedVersion}" /><CheckBox Style="{StaticResource Toggle}" Content="Open Discord after first install" IsChecked="{Binding Settings.OpenDiscordAfterFirstInstall}" /></StackPanel></Border><TextBlock Text="TOOLS" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" Margin="0,2,0,7" /><WrapPanel><Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenLauncherFolderCommand}" Content="OPEN FOLDER" Margin="0,0,9,7" /><Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenLogsFolderCommand}" Content="OPEN LOGS" Margin="0,0,9,7" /><Button Style="{StaticResource Button.Secondary}" Command="{Binding ClearCacheCommand}" Content="CLEAR CACHE" Margin="0,0,9,7" /></WrapPanel><Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Width="164" Margin="0,7,0,0" Command="{Binding SaveSettingsCommand}" Content="SAVE CHANGES" /></StackPanel></ScrollViewer></Border></Grid>
                <Grid Visibility="{Binding IsInstallation, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#0E120D"><Border Width="560" Background="#161C14" BorderBrush="#33402E" BorderThickness="1" CornerRadius="24" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Installing" Style="{StaticResource Type.Eyebrow}" Foreground="{StaticResource Brush.Accent}" /><TextBlock Text="{Binding InstallationMessage}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" Margin="0,10,0,0" /><ProgressBar Height="8" Margin="0,28,0,10" Minimum="0" Maximum="100" Value="{Binding InstallationPercentage, Mode=OneWay}" /><Grid><TextBlock Text="{Binding InstallationPercentage, StringFormat={}{0:0}%}" Style="{StaticResource Type.Body}" /><Button HorizontalAlignment="Right" Width="110" Style="{StaticResource Button.Secondary}" Command="{Binding CancelInstallationCommand}" Content="CANCEL" /></Grid><TextBlock Text="Every file is checked before Windows package changes begin." Style="{StaticResource Type.Body}" Margin="0,27,0,0" /></StackPanel></Border></Grid>
            </Grid>
            <Border Grid.RowSpan="2" Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#C8000000"><Grid><Border Width="470" Background="#192016" BorderBrush="#425139" BorderThickness="1" CornerRadius="22" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Install this version?" Style="{StaticResource Type.PageTitle}" FontSize="28" /><TextBlock Text="{Binding SelectedVersion.DisplayName}" Foreground="{StaticResource Brush.Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="Erase will verify all package files before it changes your installed Minecraft version." Style="{StaticResource Type.Body}" Margin="0,12,0,23" /><CheckBox Style="{StaticResource Toggle}" Content="Preserve worlds and packs" IsChecked="{Binding PreserveData}" Margin="0,0,0,24" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelConfirmationCommand}" Content="CANCEL" Margin="0,0,10,0" /><Button Style="{StaticResource Button.Primary}" Command="{Binding ConfirmInstallCommand}" Content="INSTALL" /></StackPanel></StackPanel></Border></Grid></Border>
        </Grid>
    </Border>
</Window>
