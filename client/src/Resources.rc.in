#include <winresrc.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/Resources.h"

ERASE_FONT_MEDIUM RCDATA "@ERASE_FONT_DIR@/Onest-Medium.ttf"
ERASE_FONT_SEMIBOLD RCDATA "@ERASE_FONT_DIR@/Onest-SemiBold.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Erase"
            VALUE "FileDescription", "Erase Client"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Licensed under the GNU AGPL v3"
            VALUE "OriginalFilename", "EraseClient.dll"
            VALUE "ProductName", "Erase Client"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
